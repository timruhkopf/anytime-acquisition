# Copied to .env by `just setup <extra> local`. Machine-specific settings only; never commit .env.
ANYTIME_ACQ_SETUP=local
ANYTIME_ACQ_TORCH_EXTRA=cpu
# ANYTIME_ACQ_RUNS_ROOT=/path/to/runs        default: <repo>/runs
# ANYTIME_ACQ_DATA_ROOT=/path/to/data        default: <repo>/data
ANYTIME_ACQ_REMOTE_HOST=<ssh-alias>
ANYTIME_ACQ_REMOTE_DIR=PycharmProjects/anytime-acquisition
# ANYTIME_ACQ_MLFLOW_URI=sqlite:////path/to/mlflow.db   default: <repo>/mlflow.db
# pfn-repro's large checkpoints (docs/checkpoints.md there): the directory holding pfn_large.pt etc.
PFN_REPRO_CKPT_ROOT=/home/ruhkopf/PycharmProjects/pfn-repro/checkpoints
